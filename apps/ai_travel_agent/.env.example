# ─── LLM 提供商(默认 deepseek,可选 openai / anthropic / google / groq 等)────
LLM_PROVIDER=deepseek
# 模型 id(留空则按 provider 取默认:deepseek→deepseek-chat,openai→gpt-4o-mini)
LLM_MODEL=

# ─── API Key(按所选 provider 提供,变量名须与 ai/catalog.ts 一致)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── 搜索后端(可选;留空时走免费 DuckDuckGo + 内置兜底)──────────────
SERPAPI_KEY=

# ─── Web 服务端口 ──────────────────────────────────────────────────
PORT=8080

# ─── 可观测性上报(可选;appId+appSecret 缺一即不启用)────────────────
# 在观测面板(observability-server :8787)的"应用管理"创建应用后填入
# OBS_APP_ID=app_xxxx
# OBS_APP_SECRET=sk_xxxx
# 收集服务地址(默认 http://localhost:8787)
# OBS_ENDPOINT=http://localhost:8787
