{
  "name": "ai-travel-agent",
  "version": "0.1.0",
  "private": true,
  "description": "基于 aipack 的 AI 旅行行程规划 Web 应用(Researcher + Planner 双 Agent + ICS 导出)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "serve": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "travel",
    "agent",
    "aipack",
    "itinerary"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aipack-ai/agent": "workspace:*",
    "@aipack-ai/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
