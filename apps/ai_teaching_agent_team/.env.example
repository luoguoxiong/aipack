# ─── LLM 提供商(默认 deepseek,可选 openai / anthropic / google / groq 等)────
LLM_PROVIDER=deepseek
# 模型 id(留空则按 provider 取默认:deepseek→deepseek-chat,openai→gpt-4o-mini)
LLM_MODEL=

# ─── API Key(按所选 provider 提供,变量名须与 ai/catalog.ts 一致)────
# Key 也可由前端用户输入(localStorage 持久化,服务器不存储),此处留空时前端必填
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── 搜索后端(可选;留空时走免费 Bing + DuckDuckGo + 内置教育兜底)──────────────
SERPAPI_KEY=

# ─── 会话存储目录(可选)────────────
# 本地默认 .agentpack/teaching-sessions;Netlify 上自动使用 /tmp(无需配置)。
# 需要显式指定时(如自定义挂载盘)才设置:
# SESSION_DIR=/tmp/teaching-sessions

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3001

# ⚠️  Netlify 部署说明
# Netlify 上无法使用 .env 文件,请在 Netlify 站点控制台
# (Site configuration → Environment variables)按需添加:
#   LLM_PROVIDER / LLM_MODEL / DEEPSEEK_API_KEY / SERPAPI_KEY 等
# 这些变量同时用于 Netlify Functions 运行时。
