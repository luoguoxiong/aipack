{
  "name": "ai-teaching-agent-team",
  "version": "0.1.0",
  "private": true,
  "description": "基于 aipack 的 AI 教学代理团队 Web 应用(4-Agent 协作:Professor + Advisor + Librarian + TA + SSE 流式 + Markdown 导出)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/server.ts\" \"vite\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "vite build && tsc",
    "serve": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "keywords": [
    "ai",
    "teaching",
    "agent",
    "aipack",
    "multi-agent",
    "education",
    "react"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aipack-ai/agent": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.10"
  }
}
