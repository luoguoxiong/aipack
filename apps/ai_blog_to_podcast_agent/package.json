{
  "name": "ai-blog-to-podcast-agent",
  "version": "0.1.3",
  "private": true,
  "description": "基于 aipack 的博客转播客 Web 应用(抓取博客正文 → 对话式摘要 → Edge TTS 免费语音合成)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "serve": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "blog",
    "podcast",
    "tts",
    "edge-tts",
    "aipack",
    "firecrawl"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aipack-ai/agent": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
