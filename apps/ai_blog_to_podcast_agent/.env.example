# ─── LLM 提供商(默认 deepseek,可选 openai / anthropic / google / groq 等)────
LLM_PROVIDER=deepseek
# 模型 id(留空则按 provider 取默认:deepseek→deepseek-chat,openai→gpt-4o-mini)
LLM_MODEL=

# ─── API Key(按所选 provider 提供,变量名须与 ai/catalog.ts 一致)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── Firecrawl 抓取后端(可选;留空时走免费原生 fetch + 兜底)──────────────
FIRECRAWL_API_KEY=

# ─── Web 服务端口 ──────────────────────────────────────────────────
PORT=3000

# 注意:ElevenLabs API Key 由前端用户输入(localStorage 持久化),服务器不存储,故不在此配置。
