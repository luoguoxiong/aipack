# ─── LLM 提供商(默认 deepseek,可选 openai / anthropic / google / groq 等)────
LLM_PROVIDER=deepseek
# 模型 id(留空则按 provider 取默认:deepseek→deepseek-chat,openai→gpt-4o-mini)
LLM_MODEL=

# ─── API Key(按所选 provider 提供,变量名须与 ai/catalog.ts 一致)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── 文件工作区目录(相对本 app 目录;Office 文件都落在这里)──────────────
# OFFICE_WORKSPACE=office-workspace

# ─── Web 服务端口 ──────────────────────────────────────────────────
PORT=3001
