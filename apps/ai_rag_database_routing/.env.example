# ─── LLM 提供商(默认 deepseek,可选 openai / anthropic / google / groq 等)────
LLM_PROVIDER=deepseek
# 模型 id(留空则按 provider 取默认:deepseek→deepseek-chat,openai→gpt-4o-mini)
LLM_MODEL=

# ─── API Key(按所选 provider 提供,变量名须与 ai/catalog.ts 一致)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── 向量相似度路由阈值(0~1;低于阈值则降级到 LLM 路由)──────────────
ROUTING_THRESHOLD=0.12

# ─── 向量存储持久化目录(相对应用根目录)──────────────────────────────
VECTOR_DB_DIR=.agentpack/rag-db

# ─── Web 服务端口 ──────────────────────────────────────────────────
PORT=8080
