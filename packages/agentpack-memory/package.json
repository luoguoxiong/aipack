{
  "name": "agentpack-memory",
  "version": "0.1.0",
  "description": "agentpack 持久化记忆插件：capture → compress → index → recall/inject → consolidate",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prebuild": "pnpm --filter agentpack build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "example": "node --import tsx examples/round-trip.ts"
  },
  "keywords": [
    "agentpack",
    "memory",
    "agent",
    "bm25",
    "context",
    "retrieval"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "agentpack": "workspace:*"
  },
  "devDependencies": {
    "agentpack": "workspace:*",
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0"
  }
}
