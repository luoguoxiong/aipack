{
  "name": "@aipack/vscode-coding",
  "version": "0.1.0",
  "description": "基于 aipack-coding 的 VSCode AI coding 助手扩展：Webview 聊天面板 + 流式输出 + 工具卡片 + 命令确认 + 跨会话记忆",
  "publisher": "aipack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aipack/nanobot-ts",
    "directory": "packages/vscode-coding"
  },
  "main": "./dist/extension.js",
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "aipack",
    "ai",
    "coding",
    "agent",
    "chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aipack-coding",
          "title": "Aipack Coding",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aipack-coding": [
        {
          "id": "aipack.coding.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aipack.coding.openChat",
          "when": "view == aipack.coding.chatView",
          "group": "navigation"
        },
        {
          "command": "aipack.coding.clearHistory",
          "when": "view == aipack.coding.chatView",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "aipack.coding.openChat",
        "title": "Open Chat",
        "category": "Aipack Coding"
      },
      {
        "command": "aipack.coding.stop",
        "title": "Stop Run",
        "category": "Aipack Coding"
      },
      {
        "command": "aipack.coding.clearHistory",
        "title": "Clear History",
        "category": "Aipack Coding"
      }
    ],
    "configuration": {
      "title": "Aipack Coding",
      "properties": {
        "aipack.provider": {
          "type": "string",
          "default": "deepseek",
          "enum": [
            "openai",
            "deepseek",
            "anthropic",
            "groq",
            "google",
            "openrouter",
            "mistral",
            "xai",
            "cerebras",
            "together",
            "fireworks",
            "nvidia",
            "moonshot"
          ],
          "enumDescriptions": [
            "OpenAI",
            "DeepSeek",
            "Anthropic",
            "Groq",
            "Google (Gemini)",
            "OpenRouter",
            "Mistral",
            "xAI (Grok)",
            "Cerebras",
            "Together AI",
            "Fireworks",
            "NVIDIA NIM",
            "Moonshot AI"
          ],
          "description": "模型提供商"
        },
        "aipack.model": {
          "type": "string",
          "default": "",
          "description": "模型 ID（留空则取该 provider 的推荐模型，如 deepseek-chat / claude-3-5-sonnet-20241022）"
        },
        "aipack.apiKey.openai": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "OpenAI API Key（写入 OPENAI_API_KEY）"
        },
        "aipack.apiKey.deepseek": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "DeepSeek API Key（写入 DEEPSEEK_API_KEY）"
        },
        "aipack.apiKey.anthropic": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Anthropic API Key（写入 ANTHROPIC_API_KEY）"
        },
        "aipack.apiKey.groq": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Groq API Key（写入 GROQ_API_KEY）"
        },
        "aipack.apiKey.google": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Google Gemini API Key（写入 GOOGLE_API_KEY）"
        },
        "aipack.apiKey.openrouter": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "OpenRouter API Key（写入 OPENROUTER_API_KEY）"
        },
        "aipack.apiKey.mistral": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Mistral API Key（写入 MISTRAL_API_KEY）"
        },
        "aipack.apiKey.xai": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "xAI (Grok) API Key（写入 XAI_API_KEY）"
        },
        "aipack.apiKey.cerebras": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Cerebras API Key（写入 CEREBRAS_API_KEY）"
        },
        "aipack.apiKey.together": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Together AI API Key（写入 TOGETHER_API_KEY）"
        },
        "aipack.apiKey.fireworks": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Fireworks API Key（写入 FIREWORKS_API_KEY）"
        },
        "aipack.apiKey.nvidia": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "NVIDIA NIM API Key（写入 NVIDIA_API_KEY）"
        },
        "aipack.apiKey.moonshot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Moonshot AI API Key（写入 MOONSHOT_API_KEY）"
        },
        "aipack.memory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用跨会话记忆（@aipack/memory），自动 capture/recall 项目约定与决策"
        },
        "aipack.memory.baseDir": {
          "type": "string",
          "default": "",
          "description": "记忆存储目录（默认 ~/.aipack/memory，支持 ~ 展开）"
        },
        "aipack.sessionDir": {
          "type": "string",
          "default": "",
          "description": "会话持久化目录（默认走扩展 globalStorage/sessions，支持 ~ 展开）"
        },
        "aipack.enabledTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read_file",
              "write_file",
              "edit_file",
              "list_directory",
              "run_command",
              "grep",
              "glob"
            ]
          },
          "default": [],
          "description": "启用的工具子集（空数组 = 全部 7 个）"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "prebuild": "pnpm --filter @aipack/agent build && pnpm --filter @aipack/memory build && pnpm --filter @aipack/coding build",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "package:vsix": "NODE_OPTIONS='--require ./scripts/vsce-polyfill.cjs' vsce package --no-dependencies"
  },
  "dependencies": {
    "@aipack/coding": "workspace:*"
  },
  "peerDependencies": {
    "@aipack/memory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "@aipack/agent": "workspace:*",
    "@aipack/memory": "workspace:*",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
