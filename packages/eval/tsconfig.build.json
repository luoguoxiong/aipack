{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "paths": {
      "@aipack-ai/agent": ["../agent/dist/index.d.ts"],
      "@aipack-ai/agent/*": ["../agent/dist/*"]
    }
  },
  "include": ["index.ts", "src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "eval", "tsup.config.ts", "tsconfig.build.json"]
}
