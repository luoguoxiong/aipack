# ════════════════════════════════════════════════════════════════
# aipack 可观测性服务 — 基础部署配置
# ════════════════════════════════════════════════════════════════
# 形态：MySQL + ClickHouse 两容器，collector 单进程直写监控库。
#   无 Kafka / Redis：上报即时落库，聚合与限流均在进程内。
#   适合：单机开发、小规模接入（日均百万级 trace 以内）。
#
# 用法（packages/observability-server 目录下）：
#   Copy-Item .env.basic .env        # Windows
#   cp .env.basic .env               # macOS / Linux
#   pnpm start:win                   # Windows 一键（等价 ./start.sh）
#
# ⚠️ 生产环境务必修改所有默认密码（MYSQL_* / CLICKHOUSE_* / ADMIN_PASS），
#    改后 MYSQL_URL 里的密码须与 MYSQL_PASSWORD 保持一致。
# ════════════════════════════════════════════════════════════════

# ── 服务 ──────────────────────────────────────────────────────────
PORT=8787

# 面板登录凭证（ADMIN_PASS 显式配置即启用多用户 JWT 鉴权）
ADMIN_USER=admin
ADMIN_PASS=admin123

# 会话签名 secret：配置后 token 无状态、重启不失效（推荐）。
# 生产建议随机长串：openssl rand -hex 32
# SESSION_SECRET=

# 启动时种入的 app 白名单（appId:appSecret，逗号分隔；已存在则跳过）
# OBS_APPS=travel-app:sk-travel123

# ── 数据保留 ──────────────────────────────────────────────────────
RETENTION_DAYS=30
PRUNE_INTERVAL_MS=3600000
PRUNE_AT_STARTUP=true

# ── 告警 ──────────────────────────────────────────────────────────
ALERTS_ENABLED=true
ALERTS_EVALUATE_INTERVAL_MS=60000
# 全局默认通知 webhook（规则级可覆盖）
# ALERTS_WEBHOOK_URL=

# ── 传输安全 / 限流 ───────────────────────────────────────────────
# TLS_KEY / TLS_CERT 同时配置则全站 HTTPS
# TLS_KEY=/path/to/key.pem
# TLS_CERT=/path/to/cert.pem
# 每应用令牌桶速率（个/秒）；<=0 关闭限流。基础部署限流在进程内
INGEST_RATE=100
# INGEST_BURST=200

# ── 容器变量（docker compose 读取；基础部署只起 mysql + clickhouse）──
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=aipack
MYSQL_USER=aipack
MYSQL_PASSWORD=aipackpass
MYSQL_PORT=3306

CLICKHOUSE_DB=aipack
CLICKHOUSE_USER=aipack
CLICKHOUSE_PASSWORD=aipackpass
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# ── 应用连接（基础部署固定直连）──────────────────────────────────
# 业务库（用户/项目/ACL/应用/模型价格）
BUSINESS_STORE=mysql
MYSQL_URL=mysql://aipack:aipackpass@localhost:3306/aipack
MYSQL_AUTO_MIGRATE=true

# 监控库（runs/spans/tool_calls 等）
TRACE_STORE=clickhouse
CLICKHOUSE_URL=http://localhost:8123

# ── 基础部署显式关闭的可选组件（保持默认即注释状态）─────────────
# MQ_ENABLED=false          # 不走 Kafka，collector 直写 CH
# AGGREGATOR=memory         # 聚合在进程内
# RATE_LIMIT_BACKEND=memory # 限流在进程内
