# aipack 可观测性收集服务配置

# 服务监听端口(默认 8787)
PORT=8787

# SQLite 数据文件路径(默认 ./.aipack/collector.db)
DB_PATH=.aipack/collector.db

# 面板登录凭证(observability-web 用)
# ADMIN_PASS 缺省时自动生成并打印,首次启动注意保存
ADMIN_USER=admin
ADMIN_PASS=admin123

# 面板会话签名 secret(P2-3,推荐配置):配置后登录 token 改为无状态 HMAC 签名,
# 服务重启不失效、零文件状态。缺省时若 ADMIN_PASS 为显式配置则以之派生;
# 两者都缺省(密码自动生成)时回退内存会话(重启后需重新登录)。
# 生产环境建议用随机长串,如: openssl rand -hex 32
# SESSION_SECRET=

# 可选:启动时种入的 app 白名单,格式 appId:appSecret,多应用逗号分隔
# 已存在则跳过;后续应用改由面板动态创建(生成 appId/appSecret)
# OBS_APPS=travel-app:sk-travel123

# 可选:面板静态文件目录(observability-web 构建产物)。
# 缺省自动定位到本包 dist/public(执行 pnpm --filter @aipack-ai/observability-server build 后即存在)，
# 此时 GET / 直接返回面板,无需任何额外配置
# STATIC_DIR=

# ── 数据保留(retention) ────────────────────────────────────────────
# 明细(runs/spans/tool_calls)保留天数(默认 30;<=0 禁用清理)
RETENTION_DAYS=30
# 清理周期 ms(默认 3600000 = 1h)
PRUNE_INTERVAL_MS=3600000
# 启动时先清理一次(默认 true)
PRUNE_AT_STARTUP=true
# 清理前 VACUUM INTO 快照备份(默认 false)
PRUNE_BACKUP=false
# 备份目录(默认 <DB 所在目录>/backup)
# PRUNE_BACKUP_DIR=./.aipack/backup

# ── 告警(alerting) ─────────────────────────────────────────────────
# 启用告警评估器(默认 true;false 关闭)
ALERTS_ENABLED=true
# 评估周期 ms(默认 60000 = 60s)
ALERTS_EVALUATE_INTERVAL_MS=60000
# 全局默认通知 webhook(规则级 webhookUrl 可覆盖)。
# 支持企业微信机器人 / Slack / 飞书机器人等任意 JSON POST 接收方
# ALERTS_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

# ── 传输安全(TLS / 限流, P1) ───────────────────────────────────────
# TLS_KEY / TLS_CERT 都配置时,收集服务以 HTTPS 提供(面板 + 上报 + 查询全加密)
# TLS_KEY=/path/to/key.pem
# TLS_CERT=/path/to/cert.pem
# ingest 限流:每应用令牌桶速率(个/秒)。<=0 或未配置则关闭限流
INGEST_RATE=100
# 突发上限(默认 rate*2,即 200)
# INGEST_BURST=200
# 面板 Trace 详情"查看日志"跳转模板(%s 替换为 traceId)。
# 指向日志系统查询地址,如 Loki/ELK;未配置则面板不显示入口
# LOG_STREAM_URL_TEMPLATE=https://loki.example.com/query?traceId=%s

# ── 平台后端（infra/docker-compose.yml 起的服务）──────────────────
# 一份 .env 同时供应用与 docker compose 使用：
#   cd packages/observability-server
#   cp .env.example .env
#   docker compose -f infra/docker-compose.yml --env-file .env up -d
# 默认 SQLite + 进程内聚合 + 同步落盘（零依赖）。切平台模式：取消"应用连接"段注释。
# 生产环境务必改密码；改后 MYSQL_URL / REDIS_URL 里的密码须与下方容器变量一致。

# ── 容器服务变量（docker compose 读；应用不读 MYSQL_PASSWORD 等离散字段）──
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=aipack
MYSQL_USER=aipack
MYSQL_PASSWORD=aipackpass
MYSQL_PORT=3306

CLICKHOUSE_DB=aipack
CLICKHOUSE_USER=aipack
CLICKHOUSE_PASSWORD=aipackpass
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

KAFKA_PORT=9094
# aipack.ingest topic 分区数(=消费者并发度上限)
KAFKA_INGEST_PARTITIONS=6

REDIS_PASSWORD=aipackpass
REDIS_PORT=6379

# ── 应用连接配置（默认 SQLite/memory/无MQ；切后端取消对应注释）──
# 业务库
# BUSINESS_STORE=mysql
# MYSQL_URL=mysql://aipack:aipackpass@localhost:3306/aipack   # 密码须与上方 MYSQL_PASSWORD 一致
# MYSQL_AUTO_MIGRATE=true

# 监控库（clickhouse 单写 / dual 双写灰度迁移，读取优先 CH）
# TRACE_STORE=clickhouse
# CLICKHOUSE_URL=http://localhost:8123   # DB/USER/PASSWORD 复用上方容器变量

# 消息队列（true 走 Kafka 解耦 ingest→worker→CH）
# MQ_ENABLED=true
# KAFKA_BROKERS=localhost:9094
# KAFKA_TOPIC=aipack.ingest
# KAFKA_DLQ_TOPIC=aipack.ingest.dlq
# KAFKA_GROUP_ID=obs-workers
# KAFKA_SASL_MECH=          # 可选: plain / scram-sha-256 / scram-sha-512
# KAFKA_SSL=false

# 分布式聚合（memory 单实例 / redis 纯 Redis / hybrid L1+L2 推荐）
# AGGREGATOR=hybrid
# REDIS_URL=redis://:aipackpass@localhost:6379   # 密码须与上方 REDIS_PASSWORD 一致
# REDIS_KEY_PREFIX=aipack:agg:

# 鉴权（默认 multi；ADMIN_PASS 显式配置即自动启用，无需手设 JWT_SECRET）
# AUTH_MODE=multi
# JWT_SECRET=               # 缺省时复用 SESSION_SECRET，再缺省由 ADMIN_PASS 派生
# JWT_ACCESS_TTL_MS=900000      # access token 15min
# JWT_REFRESH_TTL_MS=604800000 # refresh token 7d
# JWT_COOKIE_SECURE=false      # HTTPS 部署改 true
# JWT_COOKIE_SAMESITE=lax

# 限流后端（默认 memory 进程内；redis 共享令牌桶，多实例用）
# RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_REDIS_URL=redis://:aipackpass@localhost:6379

# Agent 发布 webhook（Phase 5；可选）
# AGENT_WEBHOOK_URL=
