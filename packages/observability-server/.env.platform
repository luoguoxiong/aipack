# ════════════════════════════════════════════════════════════════
# aipack 可观测性服务 — 平台模式配置
# ════════════════════════════════════════════════════════════════
# 形态：全量容器（MySQL + ClickHouse + ZooKeeper + Kafka + Redis）。
#   上报链路：collector → Kafka(aipack.ingest) → ingest-worker → CH
#   聚合：hybrid（进程内 L1 窗口 + Redis L2 共享窗口）
#   限流：Redis 共享令牌桶（多实例一致）
#   适合：生产部署、多实例扩容、高吞吐削峰。
#
# 用法（packages/observability-server 目录下）：
#   Copy-Item .env.platform .env      # Windows
#   cp .env.platform .env             # macOS / Linux
#   pnpm start:win -- -Full           # Windows 一键（等价 ./start.sh --full）
#   # 或手动：先起容器再各开终端跑 collector 与 worker
#   docker compose -f infra/docker-compose.yml --env-file .env up -d
#   pnpm --filter @aipack-ai/observability-server dev      # 终端 1：collector
#   pnpm --filter @aipack-ai/observability-server worker   # 终端 2：worker
#
# ⚠️ 生产环境务必修改所有默认密码（MYSQL_* / CLICKHOUSE_* / REDIS_* /
#    ADMIN_PASS / JWT_SECRET），改后各 *_URL 里的密码须与容器变量一致。
# ════════════════════════════════════════════════════════════════

# ── 服务 ──────────────────────────────────────────────────────────
PORT=8787

# 面板登录凭证（ADMIN_PASS 显式配置即启用多用户 JWT 鉴权）
ADMIN_USER=admin
ADMIN_PASS=admin123

# 会话/JWT 签名 secret：平台模式多实例部署必须显式配置（各实例一致），
# 否则各实例各自派生、token 互不认账。生产建议随机长串：openssl rand -hex 32
# SESSION_SECRET=
# JWT_SECRET=                # 缺省复用 SESSION_SECRET，再缺省由 ADMIN_PASS 派生
# JWT_ACCESS_TTL_MS=900000      # access token 15min
# JWT_REFRESH_TTL_MS=604800000 # refresh token 7d
# JWT_COOKIE_SECURE=false      # HTTPS 部署改 true
# JWT_COOKIE_SAMESITE=lax

# 启动时种入的 app 白名单（appId:appSecret，逗号分隔；已存在则跳过）
# OBS_APPS=travel-app:sk-travel123

# ── 数据保留 ──────────────────────────────────────────────────────
RETENTION_DAYS=30
PRUNE_INTERVAL_MS=3600000
PRUNE_AT_STARTUP=true

# ── 告警 ──────────────────────────────────────────────────────────
ALERTS_ENABLED=true
ALERTS_EVALUATE_INTERVAL_MS=60000
# 全局默认通知 webhook（规则级可覆盖）
# ALERTS_WEBHOOK_URL=

# ── 传输安全 / 限流 ───────────────────────────────────────────────
# TLS_KEY / TLS_CERT 同时配置则全站 HTTPS
# TLS_KEY=/path/to/key.pem
# TLS_CERT=/path/to/cert.pem
INGEST_RATE=100
# INGEST_BURST=200

# ── 容器变量（docker compose 读取；平台模式起全部服务）───────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=aipack
MYSQL_USER=aipack
MYSQL_PASSWORD=aipackpass
MYSQL_PORT=3306

CLICKHOUSE_DB=aipack
CLICKHOUSE_USER=aipack
CLICKHOUSE_PASSWORD=aipackpass
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

KAFKA_PORT=9094
# aipack.ingest topic 分区数（=消费者并发度上限）
KAFKA_INGEST_PARTITIONS=6

REDIS_PASSWORD=aipackpass
REDIS_PORT=6379

# ── 应用连接 ──────────────────────────────────────────────────────
# 业务库（用户/项目/ACL/应用/模型价格）
BUSINESS_STORE=mysql
MYSQL_URL=mysql://aipack:aipackpass@localhost:3306/aipack
MYSQL_AUTO_MIGRATE=true

# 监控库（runs/spans/tool_calls 等）
TRACE_STORE=clickhouse
CLICKHOUSE_URL=http://localhost:8123

# ── 消息队列（平台模式核心：collector 与 worker 解耦）────────────
MQ_ENABLED=true
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC=aipack.ingest
KAFKA_DLQ_TOPIC=aipack.ingest.dlq
KAFKA_GROUP_ID=obs-workers
# KAFKA_SASL_MECH=           # 可选: plain / scram-sha-256 / scram-sha-512
# KAFKA_SASL_USER=
# KAFKA_SASL_PASS=
# KAFKA_SSL=false
# worker 消费调优
# KAFKA_CONSUMER_BATCH=500   # 单批最大消息数
# KAFKA_CONSUMER_WAIT=1000   # 攒批窗口 ms
# KAFKA_MAX_RETRIES=3        # 处理失败重试次数（超限进 DLQ）
# KAFKA_FROM_BEGINNING=false # 无位点时从头消费（仅首次部署排查用）

# ── 分布式聚合（hybrid = L1 进程内 60s + L2 Redis 1h）────────────
AGGREGATOR=hybrid
REDIS_URL=redis://:aipackpass@localhost:6379
# REDIS_KEY_PREFIX=aipack:agg:
# AGGREGATOR_L1_WINDOW_MS=60000
# AGGREGATOR_L2_WINDOW_MS=3600000

# ── 限流后端：Redis 共享令牌桶（多实例一致；缺省复用 REDIS_URL）──
RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_REDIS_URL=redis://:aipackpass@localhost:6379

# ── Agent 发布 webhook（可选）────────────────────────────────────
# AGENT_WEBHOOK_URL=
