{
  "name": "@aipack-ai/coding",
  "version": "1.0.1",
  "description": "aipack coding 工具集 + coding agent 工厂 + CLI：文件读写、命令执行、代码搜索",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aipack-coding": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prebuild": "pnpm --filter @aipack-ai/agent build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "example": "node --import tsx examples/round-trip.ts"
  },
  "keywords": [
    "aipack",
    "coding",
    "agent",
    "tools",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@aipack-ai/agent": "workspace:*"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@aipack-ai/agent": "workspace:*",
    "@aipack-ai/memory": "workspace:*",
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0"
  }
}
