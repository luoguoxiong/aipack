{
  "name": "@aipack/compression",
  "version": "0.1.0",
  "description": "aipack 多级上下文压缩：L1 工具输出裁剪 -> L2 旧消息摘要 -> L3 任务状态提取 -> L4 会话检查点 -> L5 新会话交接",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prebuild": "pnpm --filter @aipack/agent build || true",
    "typecheck": "tsc --noEmit",
    "example": "node --import tsx examples/compression-demo.ts",
    "test": "node --import tsx --test test/safety.test.ts test/l1-l4.test.ts test/transformer.test.ts test/retry.test.ts"
  },
  "keywords": [
    "aipack",
    "compression",
    "context",
    "agent",
    "compaction",
    "summarization",
    "checkpoint"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@aipack/agent": "workspace:*"
  },
  "devDependencies": {
    "@aipack/agent": "workspace:*",
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
