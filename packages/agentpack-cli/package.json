{
  "name": "agentpack-cli",
  "version": "0.1.0",
  "description": "agentpack 命令行工具：交互式聊天、一次性提问、会话管理与回放",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentpack": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prebuild": "pnpm --filter agentpack build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "ai",
    "cli",
    "agentpack"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "agentpack": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  }
}
