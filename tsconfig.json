{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@aipack/agent": ["./packages/agent/index.ts"],
      "@aipack/agent/*": ["./packages/agent/*"],
      "@aipack/memory": ["./packages/memory/index.ts"],
      "@aipack/coding": ["./packages/coding/index.ts"],
      "@aipack/compression": ["./packages/compression/index.ts"]
    }
  },
  "include": ["packages/**/*", "examples/**/*"],
  "exclude": ["node_modules", "dist", "webui"]
}
