{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "agentpack": ["./packages/agentpack/index.ts"],
      "agentpack/*": ["./packages/agentpack/*"]
    }
  },
  "include": ["src/**/*", "packages/**/*", "examples/**/*"],
  "exclude": ["node_modules", "dist", "webui", "tests"]
}
